[Unit]
Description=Pelican Webserver
After=network.target

[Service]
Type=simple
User=apache
Group=apache
WorkingDirectory=/var/www/blog
Environment=/var/www/blog/.venv/bin
ExecStart=/usr/bin/bash /var/www/blog/system/run.sh
ExecReload=/var/www/blog/.venv/bin/pelican content
KillSignal=SIGQUIT
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

